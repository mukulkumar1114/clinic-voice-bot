# Copy this file to .env and fill in the keys.

# 1. LiveKit Cloud (free tier) - https://cloud.livekit.io -> Settings -> API keys
#    Also pays for speech-to-text (Deepgram) and voice (Cartesia) through LiveKit Inference,
#    so no separate Deepgram/Cartesia accounts are needed.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 2. Anthropic (Claude) - https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Brain model. Leave empty: uses Claude Opus 5.5 if ANTHROPIC_API_KEY is set,
# otherwise openai/gpt-4.1-mini through LiveKit (no extra key).
# Options: claude-haiku-5-5, claude-opus-5-5, openai/gpt-4.1-mini, google/gemini-2.5-flash
LLM_MODEL=

# Voice settings (optional)
TTS_MODEL=cartesia/sonic-3
TTS_LANGUAGE=hi
TTS_VOICE=

# 3. Phone calls (later, phase 2) - outbound SIP trunk id from LiveKit (Exotel or Twilio)
SIP_OUTBOUND_TRUNK_ID=
# SAFETY: every real call goes ONLY to this number (yours), never to a number from the database.
TEST_CALL_NUMBER=

# Optional: names used by scenario R01 when you test by voice (defaults: Test Customer / Bruno)
R01_CUSTOMER=
R01_PET=
